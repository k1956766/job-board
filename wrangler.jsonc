{
  "name": "job-board",
  "main": "worker.js",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    { "binding": "JOBS", "id": "543e53b3a16847f5b5b1d4b796768294" }
  ],
  "observability": { "enabled": false }
}
